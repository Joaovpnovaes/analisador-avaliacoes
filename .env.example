# Copie este arquivo para .env e preencha a sua chave.
# O .env nunca deve ir para o GitHub (ele já está no .gitignore).

# Opção 1 (padrão): Groq, gratuito, na nuvem — https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=sua_chave_aqui
LLM_MODEL=openai/gpt-oss-20b

# Opção 2: Google Gemini, gratuito — https://aistudio.google.com
# Confira no AI Studio o nome exato do modelo disponível na sua conta.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=sua_chave_do_gemini
# LLM_MODEL=gemini-2.5-flash

# Opção 3: Llama 3.2 3B rodando no seu PC com o Ollama — https://ollama.com
# Antes, rode no terminal: ollama pull llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2:3b

# Pausa entre chamadas, em segundos (o plano gratuito do Groq aceita ~30 por minuto).
# Com o Ollama local pode ser 0.
LLM_PAUSA=2.1
